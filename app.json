{
  "expo": {
    "name": "Campus IQ",
    "slug": "CampusIQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image_8906d951.png",
    "scheme": "campusiq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/image_8906d951.png",
      "resizeMode": "contain",
      "backgroundColor": "#001f4d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paneinyasha.campusiq"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1650",
        "foregroundImage": "./assets/images/image_8906d951.png"
      },
      "package": "com.paneinyasha.campusiq",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Campus IQ needs camera access to scan QR codes for attendance"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "540b5e18-9605-43c1-a1db-8c4aac9adb18"
      }
    }
  }
}